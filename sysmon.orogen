name "sysmon"

import_types_from "base"
import_types_from "sysmonTypes.hpp"

# This task outputs monitoring information about system resources like disk IO by reading
# from /proc/diskstats
task_context "Task" do
    needs_configuration

    # List of devices to monitor, e.g. ["sda", "nvme0n1"].
    # If empty, monitors all devices.
    property("devices", "/std/vector</std/string>")

    # Path to the diskstats file (defaults to /proc/diskstats)
    property("diskstats_path", "/std/string", "/proc/diskstats")

    error_states :INVALID_DISKSTATS_PATH

    output_port "stats", "/sysmon/SystemStats"

    periodic 1
end
